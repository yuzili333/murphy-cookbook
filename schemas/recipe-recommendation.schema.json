{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://murphy-cookbook.local/schemas/recipe-recommendation.schema.json",
  "title": "RecipeRecommendationResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "recipes",
    "follow_up_questions",
    "filtered_allergens",
    "message"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "need_more_info", "no_match"]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "filtered_allergens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "follow_up_questions": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "string"
      }
    },
    "recipes": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/recipe"
      }
    }
  },
  "$defs": {
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "english_name",
        "name_learning",
        "age_range",
        "difficulty",
        "estimated_time_minutes",
        "fit_reasons",
        "nutrition_summary",
        "risk_alerts",
        "requires_extra_ingredients",
        "extra_ingredients",
        "steps_preview"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "english_name": {
          "type": "string",
          "minLength": 1
        },
        "name_learning": {
          "$ref": "#/$defs/nameLearning"
        },
        "age_range": {
          "type": "string",
          "minLength": 1
        },
        "difficulty": {
          "type": "string",
          "enum": ["easy", "medium", "hard"]
        },
        "estimated_time_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 120
        },
        "fit_reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string"
          }
        },
        "nutrition_summary": {
          "type": "string",
          "minLength": 1
        },
        "risk_alerts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requires_extra_ingredients": {
          "type": "boolean"
        },
        "extra_ingredients": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "steps_preview": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/stepPreview"
          }
        }
      }
    },
    "nameLearning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["characters"],
      "properties": {
        "characters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/nameCharacter"
          }
        }
      }
    },
    "nameCharacter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character", "pinyin", "strokes", "structure", "hint"],
      "properties": {
        "character": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "pinyin": {
          "type": "string",
          "minLength": 1,
          "description": "Use tone-mark pinyin such as fān or qié, not numeric tone pinyin such as fan1."
        },
        "strokes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "structure": {
          "type": "string",
          "minLength": 1
        },
        "hint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "stepPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "risk_level", "requires_parent_assist"],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "risk_level": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "requires_parent_assist": {
          "type": "boolean"
        }
      }
    }
  }
}
