{
  "name": "murphy-cookbook-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev:frontend": "pnpm --filter @murphy-cookbook/frontend dev",
    "dev:server": "pnpm --filter @murphy-cookbook/server dev",
    "build": "pnpm --filter @murphy-cookbook/frontend build && pnpm --filter @murphy-cookbook/server build",
    "build:frontend": "pnpm --filter @murphy-cookbook/frontend build",
    "build:server": "pnpm --filter @murphy-cookbook/server build",
    "test:api": "pnpm --filter @murphy-cookbook/server test:api",
    "test:e2e": "pnpm --filter @murphy-cookbook/frontend test:e2e"
  }
}
